<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Stock Quant Tree Editable -->
    <record id="view_stock_quant_tree_editable_inherit_selling_value" model="ir.ui.view">
        <field name="name">stock.quant.list.editable.inherit.selling.value</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="total_selling_value" optional="show" sum="Total Selling Value"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Stock Quant Tree -->
    <record id="view_stock_quant_tree_inherit_selling_value" model="ir.ui.view">
        <field name="name">stock.quant.list.inherit.selling.value</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="total_selling_value" optional="show" sum="Total Selling Value"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit Stock Quant Inventory Tree Editable -->
    <record id="view_stock_quant_tree_inventory_editable_inherit_selling_value" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable.inherit.selling.value</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_uom_id']" position="after">
                <field name="total_selling_value" optional="show" sum="Total Selling Value"/>
            </xpath>
        </field>
    </record>
</odoo>
